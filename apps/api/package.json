{
  "name": "@coloc/api",
  "version": "0.1.0",
  "private": true,
  "description": "The agency: HTTP API for the website + the hub that talks to every house's agent.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../dev/.env.local --env-file-if-exists=../../dev/.env.github --env-file-if-exists=../../dev/.env.paydunya --env-file-if-exists=../../dev/.env.paxity dist/main.js",
    "seed": "node --env-file-if-exists=../../dev/.env.local dist/seed/run.js",
    "test": "vitest run",
    "dev:watch": "tsc -p tsconfig.json && (tsc -w -p tsconfig.json --preserveWatchOutput & node --watch dist/main.js)",
    "dev": "node ../../scripts/up.mjs"
  },
  "dependencies": {
    "@coloc/db": "*",
    "@coloc/domain": "*",
    "@coloc/protocol": "*",
    "@ip-location-db/dbip-country-mmdb": "^2.3.2026060120",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-ws": "^10.4.7",
    "@nestjs/websockets": "^10.4.7",
    "mmdb-lib": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.9.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
