{
  "name": "@coloc/api",
  "version": "0.1.0",
  "private": true,
  "description": "The agency: HTTP API for the website + the hub that talks to every house's agent.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "node dist/seed/run.js",
    "dev": "tsc -p tsconfig.json && (tsc -w -p tsconfig.json --preserveWatchOutput & node --watch dist/main.js)",
    "test": "vitest run"
  },
  "dependencies": {
    "@coloc/db": "*",
    "@coloc/domain": "*",
    "@coloc/protocol": "*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/platform-ws": "^10.4.7",
    "@nestjs/websockets": "^10.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
